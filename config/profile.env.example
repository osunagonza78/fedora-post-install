# =============================================================================
# fpi profile — opt-in/out toggles for personal preferences
# =============================================================================
# Copy this file to `config/profile.env` and edit. Each install script sources
# `config/profile.env` (if it exists) before doing anything, so changes you
# make here override the built-in defaults.
#
# Every ENABLE_* flag is "1" by default — set to "0" to skip that feature.
# =============================================================================

# --- Browsers ---
ENABLE_BRAVE_BROWSER=1

# --- Windows compatibility ---
ENABLE_WINE=1

# --- Fonts ---
ENABLE_MS_FONTS=1
ENABLE_FIRACODE=1

# --- Shell prompt customisation ---
# ENABLE_OMP installs the Oh My Posh binary + themes.
# ENABLE_SHELL_PROMPT writes the prompt init block + fastfetch banner into
# your shell's rc file (~/.bashrc, ~/.zshrc, or ~/.config/fish/config.fish).
# OMP_THEME picks which JSON in ~/.poshthemes/ gets loaded.
ENABLE_OMP=1
ENABLE_SHELL_PROMPT=1
OMP_THEME=jandedobbeleer

# --- IDEs ---
ENABLE_JETBRAINS=1
ENABLE_VSCODE=1
